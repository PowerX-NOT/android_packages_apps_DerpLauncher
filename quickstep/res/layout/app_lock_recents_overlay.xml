<?xml version="1.0" encoding="utf-8"?>
<!--
     App Lock recents thumbnail mask (padlock + label).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_lock_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:clickable="false"
    android:focusable="false"
    android:importantForAccessibility="no"
    android:background="@color/app_lock_recents_overlay_scrim">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_protected_locked_recents" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/app_lock_recents_overlay_label_margin_top"
            android:fontFamily="sans-serif"
            android:gravity="center_horizontal"
            android:text="@string/app_lock_recents_locked_label"
            android:textAlignment="center"
            android:textColor="@color/app_lock_recents_overlay_tint"
            android:textSize="@dimen/app_lock_recents_overlay_label_text_size" />
    </LinearLayout>
</FrameLayout>
